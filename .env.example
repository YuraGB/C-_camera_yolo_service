# Camera CV Service local runtime configuration.
# Copy to .env or load these variables in your shell before starting the service.

CAMERA_MODEL_PATH=models/yolov8x.onnx
CAMERA_TEST_VIDEO_PATH=media/test_video.mp4
# Optional helper-script URLs. The service itself does not download assets.
# CAMERA_MODEL_URL=https://example.com/path/to/yolov8x.onnx
# CAMERA_TEST_VIDEO_URL=https://example.com/path/to/test_video.mp4

CAMERA_SIGNALING_URL=ws://127.0.0.1:3002/ws
CAMERA_PEER_ID=camera-cv-service
# CAMERA_REMOTE_PEER_ID=frontend-your-session-id
# Use the same value as server_for_cam_det AUTH_JWT_SECRET.
# CAMERA_AUTH_JWT_SECRET=replace-with-the-same-strong-secret-as-the-server
CAMERA_AUTH_JWT_ISSUER=cam_frontend
CAMERA_AUTH_JWT_AUDIENCE=cam_serv
CAMERA_AUTH_JWT_ROLE=service
CAMERA_AUTH_JWT_TTL_SECONDS=300

CAMERA_MAX_CAMERA_SCAN=10

CAMERA_INFERENCE_WIDTH=640
CAMERA_INFERENCE_HEIGHT=640
CAMERA_CONF_THRESHOLD=0.25
CAMERA_IOU_THRESHOLD=0.45

CAMERA_H264_BITRATE_BPS=2500000
# Windows default: openh264-2.6.0-win64.dll
# Linux default: libopenh264.so.2
# CAMERA_OPENH264_LIBRARY=libopenh264.so.2
CAMERA_MAX_LIVE_LATENCY_MS=150
CAMERA_MAX_LIVE_WIDTH=1280
CAMERA_MAX_LIVE_HEIGHT=720

# Set to 0 to disable live-video latency samples.
CAMERA_VIDEO_LATENCY_SAMPLE_INTERVAL_MS=1000
CAMERA_PIPELINE_METRICS_INTERVAL_MS=1000
CAMERA_MAX_DETECTION_BUFFERED_BYTES=131072

CAMERA_VERBOSE_LOGS=false
